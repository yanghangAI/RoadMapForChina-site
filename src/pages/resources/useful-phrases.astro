      { intent: 'delicious', zh: '很好吃', pinyin: 'Hěn hǎo chī', en: 'This is delicious', it: 'È buonissimo' },
      { intent: 'too spicy', zh: '太辣了', pinyin: 'Tài là le', en: 'Too spicy', it: 'Troppo piccante' },
      { intent: 'no coriander', zh: '不要香菜', pinyin: 'Bù yào xiāngcài', en: 'No coriander (cilantro)', it: 'Senza coriandolo' },
