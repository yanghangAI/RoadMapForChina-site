      { intent: 'yogurt', zh: '酸奶', pinyin: 'Suānnǎi', en: 'Yogurt — local Tibetan-style in Qilian is excellent', it: 'Yogurt — quello tibetano di Qilian è ottimo' },
      { intent: 'lamb hotpot', zh: '涮羊肉', pinyin: 'Shuàn yángròu', en: 'Lamb hotpot', it: 'Hotpot di agnello' },
