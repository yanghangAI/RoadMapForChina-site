      { intent: 'yak yogurt', zh: '牦牛酸奶', pinyin: 'Máoniú suānnǎi', en: 'Yak yogurt — thick, tangy, found in Qinghai', it: 'Yogurt di yak — denso, intenso, si trova nel Qinghai' },
      { intent: 'barley wine', zh: '青稞酒', pinyin: 'Qīngkē jiǔ', en: 'Highland barley wine — local Tibetan alcohol, strong', it: "Liquore d'orzo d'altura — alcolico tibetano, forte" },
