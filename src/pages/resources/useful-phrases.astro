  {
    label: 'numbers ~',
    items: [
      { intent: 'one', zh: '一', pinyin: 'yī', en: '1', it: 'Uno' },
      { intent: 'two', zh: '二 / 两', pinyin: 'èr / liǎng', en: '2', it: 'Due' },
