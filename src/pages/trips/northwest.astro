---
import Base from '../../layouts/Base.astro';
import InteractiveMap from '../../components/InteractiveMap.astro';
import SplitView from '../../components/SplitView.astro';
import DayCard from '../../components/DayCard.astro';
import PaperCard from '../../components/primitives/PaperCard.astro';
import Stamp from '../../components/primitives/Stamp.astro';
import Marginalia from '../../components/primitives/Marginalia.astro';
import { tripDays, locations } from '../../data/locations';

const base = import.meta.env.BASE_URL;
const phaseDays = tripDays.filter(d => d.phaseNum === 3);

const mapMarkers = [
  { name: 'Xining · 西宁', coords: [36.617, 101.767] as [number, number], color: 'var(--color-muted)', label: '🚄', phase: 'Start/End', dates: 'Jul 18 & 24', transport: '🚄 D2685 arrives 12:49pm' },
  { name: 'Riyueshan Pass · 日月山', coords: [36.517, 101.083] as [number, number], color: 'var(--color-phase-northwest)', label: '1', phase: 'Day 1', dates: 'Jul 18', href: 'northwest/riyueshan' },
  { name: 'Qinghai Lake · 青海湖', coords: [36.9, 100.183] as [number, number], color: 'var(--color-phase-northwest)', label: '1', phase: 'Day 1', dates: 'Jul 18', href: 'northwest/qinghai-lake' },
  { name: 'Chaka Salt Lake · 茶卡盐湖', coords: [36.717, 99.083] as [number, number], color: 'var(--color-phase-northwest)', label: '2', phase: 'Day 2', dates: 'Jul 18-19', href: 'northwest/chaka-salt-lake' },
  { name: 'Delingha · 德令哈', coords: [37.367, 97.367] as [number, number], color: 'var(--color-phase-northwest)', label: '2', phase: 'Day 2', dates: 'Jul 19', href: 'northwest/delingha' },
  { name: 'Feicui Hu · 翡翠湖', coords: [37.85, 95.367] as [number, number], color: 'var(--color-phase-northwest)', label: '3', phase: 'Day 3', dates: 'Jul 19-20', href: 'northwest/feicui-hu' },
  { name: 'Dunhuang Night Market · 沙州夜市', coords: [40.142, 94.662] as [number, number], color: 'var(--color-vermillion-soft)', label: '3', phase: 'Day 3', dates: 'Jul 20', href: 'northwest/dunhuang-night-market' },
  { name: 'Mogao Caves · 莫高窟', coords: [40.038, 94.806] as [number, number], color: 'var(--color-vermillion-soft)', label: '4', phase: 'Day 4', dates: 'Jul 21', href: 'northwest/mogao-caves' },
  { name: 'Mingsha Dunes · 鸣沙山月牙泉', coords: [40.085, 94.674] as [number, number], color: 'var(--color-vermillion-soft)', label: '4', phase: 'Day 4', dates: 'Jul 21', href: 'northwest/mingsha-dunes' },
  { name: 'Jiayuguan Fort · 嘉峪关', coords: [39.817, 98.3] as [number, number], color: 'var(--color-phase-northwest)', label: '5', phase: 'Day 5', dates: 'Jul 22', href: 'northwest/jiayuguan-fort' },
  { name: 'Qicai Danxia · 七彩丹霞', coords: [38.937, 100.467] as [number, number], color: 'var(--color-phase-northwest)', label: '6', phase: 'Day 6', dates: 'Jul 23', href: 'northwest/qicai-danxia' },
  { name: 'Qilian Grassland · 祁连草原', coords: [38.183, 100.25] as [number, number], color: 'var(--color-phase-northwest)', label: '6', phase: 'Day 6', dates: 'Jul 23-24', href: 'northwest/qilian-grassland' },
  { name: 'Menyuan Flowers · 门源油菜花', coords: [37.383, 101.617] as [number, number], color: 'var(--color-phase-northwest)', label: '7', phase: 'Day 7', dates: 'Jul 24', href: 'northwest/menyuan-flowers' },
  // Optional stops
  { name: "Ta'er Monastery · 塔尔寺", coords: [36.479, 101.578] as [number, number], color: 'var(--color-muted)', label: '◆', phase: 'Optional · near Xining', href: 'northwest/taer-monastery', optional: true },
  { name: 'Yardang Geopark · 雅丹魔鬼城', coords: [40.525, 93.303] as [number, number], color: 'var(--color-muted)', label: '◆', phase: 'Optional · near Dunhuang', href: 'northwest/yardang', optional: true },
  { name: 'Giant Buddha Temple · 张掖大佛寺', coords: [38.936, 100.452] as [number, number], color: 'var(--color-muted)', label: '◆', phase: 'Optional · in Zhangye', href: 'northwest/zhangye-dafo', optional: true },
  { name: 'Shandan Horse Farm · 山丹军马场', coords: [38.560, 100.850] as [number, number], color: 'var(--color-muted)', label: '◆', phase: 'Optional · Day 6 route', href: 'northwest/shandan-horse-farm', optional: true },
  { name: 'Zhuoer Mountain · 卓尔山', coords: [38.204, 100.217] as [number, number], color: 'var(--color-muted)', label: '◆', phase: 'Optional · near Qilian', href: 'northwest/zhuoer-mountain', optional: true },
];

const dayRoutes: Record<number, string> = {
  1: '🚄 D2685 to Xining 12:49 · 🚗 Xining → Chaka · 300km / 4h',
  2: '🚗 Chaka → Dachaidan · 330km / 4h',
  3: '🚗 Dachaidan → Dunhuang · 500km / 6h',
  4: '🥾 Dunhuang full day',
  5: '🚗 Dunhuang → Jiayuguan · 400km / 4.5h',
  6: '🚗 Jiayuguan → Qilian · 460km / 6h',
  7: '🚗 Qilian → Xining · 280km / 3.5h · ✈️ fly XNN → CTU evening',
};

const dayAccommodation: Record<number, string> = {
  1: 'Chaka',
  2: 'Dachaidan',
  3: 'Dunhuang',
  4: 'Dunhuang',
  5: 'Jiayuguan',
  6: 'Qilian',
  7: 'Back to Xining',
};

const dayNotes: Record<number, string> = {
  1: 'set 6am alarm — Chaka mirror at sunrise',
  2: 'fill tank in Dachaidan!',
  3: 'confirm Mogao booking tonight',
  6: 'ask hotel to arrange 7 horses for 8am',
};

// Build highlight items per day from destination slugs, using locations.name for display.
function highlightsForDay(slugs: string[]) {
  return slugs
    .map(s => locations[s])
    .filter(Boolean)
    .map(l => ({ name: l.name, href: l.slug }));
}
---

<Base title="Northwest Road Trip · 大西北 · July 18–24">

  <header class="mb-4">
    <a href={base} class="text-sm text-muted hover:text-vermillion-soft">← Full trip overview</a>
    <h1 class="font-display italic font-semibold text-[36px] leading-none mt-2">
      Northwest <span class="font-zh not-italic text-[28px] text-ink-soft">大西北</span>
    </h1>
    <div class="font-mono uppercase text-[11px] tracking-[.14em] text-muted mt-1">PHASE 3 · JUL 18 – JUL 24 · 7 PEOPLE · 1 CAR</div>
    <p class="mt-3 max-w-prose text-[14px] text-ink-soft">
      Loop from Xining: Qinghai Lake → Chaka → Feicui Hu → Dunhuang → Jiayuguan → Danxia → Qilian → Xining. ~2,220km in a 7-seater. Budget–midrange. Fly out to Chengdu on the last evening.
    </p>
  </header>

  <SplitView phaseKey="northwest">
    <div slot="map" class="h-full">
      <InteractiveMap id="northwest-map" markers={mapMarkers} center={[38.5, 98]} zoom={6} height="100%" />
    </div>

    <div slot="list">
      {phaseDays.map(d => (
        <DayCard
          day={d.dayInTrip}
          dayInPhase={d.dayInPhase}
          date={d.date}
          headline={d.headline}
          headlineIt={d.headlineIt}
          route={dayRoutes[d.dayInPhase]}
          highlights={highlightsForDay(d.destinationSlugs)}
          accommodation={dayAccommodation[d.dayInPhase]}
          note={dayNotes[d.dayInPhase]}
          anchorId={`day-${d.dayInTrip}`}
        />
      ))}

      <PaperCard class="mt-6 bg-paper">
        <Stamp rotate={-3}>book now</Stamp>
        <ul class="list-disc pl-5 mt-3 text-[13px] space-y-1">
          <li><strong>Mogao Caves</strong> — 7 tickets for Jul 21 morning, before April 18 → <a href="https://mgk.com.cn" target="_blank" class="text-vermillion-soft underline">mgk.com.cn</a></li>
          <li><strong>Chaka Salt Lake tickets</strong> — book online before June</li>
          <li><strong>Dunhuang hotel</strong> — 2 nights Jul 20–22, before May</li>
          <li><strong>Other hotels</strong> — Chaka, Dachaidan, Jiayuguan, Qilian, before June</li>
          <li><strong>7-seater rental</strong> — confirm car + luggage solution in Xining, before June</li>
        </ul>
        <Marginalia position="br" rotate={-2}>do this first!!</Marginalia>
      </PaperCard>
    </div>
  </SplitView>

  <hr class="my-8 dashed-divider" />

  <h2 class="font-display text-2xl font-bold mb-4">Day-by-day detail</h2>

  <article class="prose">
    <h3 id="day-5-detail">Day 1 · July 18 · Xining → Qinghai Lake → Chaka</h3>
    <p class="italic text-muted">300km · 4h driving · Sleep: Chaka · 15–20°C</p>
    <ul>
      <li><strong>12:49pm</strong> Arrive Xining by D2685 from Xi'an North. Lunch near station.</li>
      <li><strong>2:00pm</strong> Pick up car, depart Xining.</li>
      <li><strong>3:30pm</strong> <a href={`${base}northwest/riyueshan`}>Riyueshan Pass (日月山)</a> (3,520m) — 20-min stop, photo, move on.</li>
      <li><strong>4:15pm</strong> <a href={`${base}northwest/qinghai-lake`}>Qinghai Lake (青海湖)</a> north shore (Erlangjian) — 1.5hrs, walk the shore.</li>
      <li><strong>6:00pm</strong> Drive to Chaka (~170km, 2hrs).</li>
      <li><strong>8:00pm</strong> Arrive Chaka, dinner, overnight.</li>
    </ul>
    <p class="text-[13px] text-ink-soft border-l-2 border-border-dash pl-3 italic">
      Tonight: Set alarm for 6am. Chaka mirror reflection only works at sunrise when the wind is still.
    </p>

    <h3 id="day-6-detail">Day 2 · July 19 · Chaka → Delingha → Feicui Hu</h3>
    <p class="italic text-muted">330km · 4h driving · Sleep: Dachaidan · 20–28°C</p>
    <ul>
      <li><strong>6:00am</strong> <a href={`${base}northwest/chaka-salt-lake`}>Chaka Salt Lake (茶卡盐湖)</a> at sunrise — the mirror reflection. 1.5hrs.</li>
      <li><strong>8:00am</strong> Breakfast, pack up.</li>
      <li><strong>8:30am</strong> Drive to Delingha (~230km, 2.5hrs).</li>
      <li><strong>11:00am</strong> Delingha — lunch, 30min walk at <a href={`${base}northwest/delingha`}>Haizi Poetry Park</a>.</li>
      <li><strong>1:00pm</strong> Drive to Feicui Hu / Dachaidan (~100km, 1hr).</li>
      <li><strong>2:00pm</strong> <a href={`${base}northwest/feicui-hu`}>Feicui Hu (翡翠湖)</a> colored lakes — 2hrs wandering.</li>
      <li><strong>4:30pm</strong> Check in Dachaidan, rest, early dinner.</li>
    </ul>
    <p class="text-[13px] text-ink-soft border-l-2 border-border-dash pl-3 italic">
      Tonight: Driver fills tank completely before sleeping — the Qaidam Basin to Dunhuang has sparse fuel stations.
    </p>

    <h3 id="day-7-detail">Day 3 · July 20 · Dachaidan → Dunhuang · The Desert Highway</h3>
    <p class="italic text-muted">500km · 6h driving · Sleep: Dunhuang · 38–42°C</p>
    <ul>
      <li><strong>8:00am</strong> Depart Dachaidan, full tank.</li>
      <li><strong>8:00am–2:00pm</strong> Qaidam Basin highway — one of the great desert drives in China. Flat salt pans stretching to the horizon, distant mountain ranges floating above the heat shimmer, almost no traffic. Stop anywhere for photos — the emptiness is the point.</li>
      <li><strong>2:30pm</strong> Arrive Dunhuang, check in (2 nights), rest — it's 40°C outside.</li>
      <li><strong>7:00pm</strong> <a href={`${base}northwest/dunhuang-night-market`}>沙州夜市 (Shazhou Night Market)</a> — first real taste of Silk Road street food. Allow 1.5hrs.</li>
    </ul>
    <p class="text-[13px] text-ink-soft border-l-2 border-border-dash pl-3 italic">
      Tonight: Confirm Mogao Caves booking for tomorrow morning. Tickets at <a href="https://mgk.com.cn" target="_blank">mgk.com.cn</a>.
    </p>

    <h3 id="day-8-detail">Day 4 · July 21 · Dunhuang Full Day</h3>
    <p class="italic text-muted">Sleep: Dunhuang · 38–42°C</p>
    <ul>
      <li><strong>8:00am</strong> <a href={`${base}northwest/mogao-caves`}>Mogao Caves (莫高窟)</a> — pre-booked morning slot, guided tour ~3hrs. Finish by 11am.</li>
      <li><strong>12:00pm</strong> Lunch, long rest indoors — do not be outside between noon and 5pm.</li>
      <li><strong>5:30pm</strong> <a href={`${base}northwest/mingsha-dunes`}>Crescent Moon Spring (月牙泉)</a> — walk to the spring first while light is still high.</li>
      <li><strong>6:30pm</strong> Mingsha Sand Dunes — camel ride at golden hour (~¥150/person), watch sunset from the ridge.</li>
      <li><strong>8:30pm</strong> Dinner, night market.</li>
    </ul>

    <h3 id="day-9-detail">Day 5 · July 22 · Dunhuang → Jiayuguan</h3>
    <p class="italic text-muted">400km · 4.5h driving · Sleep: Jiayuguan · 30–35°C</p>
    <ul>
      <li><strong>8:00am</strong> Depart Dunhuang.</li>
      <li><strong>12:30pm</strong> Arrive Jiayuguan, lunch.</li>
      <li><strong>2:00pm</strong> <a href={`${base}northwest/jiayuguan-fort`}>Jiayuguan Fort (嘉峪关)</a> — western end of the Great Wall, "Greatest Pass Under Heaven." Walk the full wall circuit. 2hrs.</li>
      <li><strong>4:30pm</strong> Overhanging Great Wall (悬壁长城) — 10km north of the fort, a section of wall that climbs vertically up a mountain face. Different in character from the fort. 45min. <em>(Optional but strongly recommended — fits the afternoon easily.)</em></li>
      <li><strong>Evening</strong> Dinner, overnight Jiayuguan.</li>
    </ul>

    <h3 id="day-10-detail">Day 6 · July 23 · Jiayuguan → Qicai Danxia → Qilian</h3>
    <p class="italic text-muted">460km · 6h driving · Sleep: Qilian · 20–25°C</p>
    <ul>
      <li><strong>8:00am</strong> Depart Jiayuguan.</li>
      <li><strong>10:30am</strong> Arrive <a href={`${base}northwest/qicai-danxia`}>Zhangye Qicai Danxia (七彩丹霞)</a> — morning light is ideal for the colors. Take the shuttle buses between platforms. 2.5hrs.</li>
      <li><strong>1:30pm</strong> Lunch in Zhangye.</li>
      <li><strong>2:30pm</strong> Drive south to Qilian County via G227 (~180km, 2.5hrs) — direct mountain route, no backtracking.</li>
      <li><strong>5:00pm</strong> Arrive <a href={`${base}northwest/qilian-grassland`}>Qilian County</a>, check in, riverside walk at dusk.</li>
      <li><strong>Evening</strong> Lamb hotpot dinner — Qilian lamb is among the best in Qinghai.</li>
    </ul>
    <p class="text-[13px] text-ink-soft border-l-2 border-border-dash pl-3 italic">
      Tonight: Ask hotel to arrange 7 horses for 8:00am tomorrow.
    </p>

    <h3 id="day-11-detail">Day 7 · July 24 · Qilian → Menyuan → Xining</h3>
    <p class="italic text-muted">280km · 3.5h driving</p>
    <ul>
      <li><strong>8:00am</strong> 1hr horseback ride on the grassland (~¥120/person). Bring a warm layer — 2,800m at 8am is cold.</li>
      <li><strong>9:30am</strong> Depart Qilian east on S302.</li>
      <li><strong>11:00am</strong> <a href={`${base}northwest/menyuan-flowers`}>Menyuan rapeseed flower fields (门源油菜花)</a> — 30min stop if in bloom. The yellow fields with snow peaks behind are the perfect farewell image.</li>
      <li><strong>12:00pm</strong> Continue north on G227 to Xining (~160km, 2hrs).</li>
      <li><strong>2:00pm</strong> Arrive Xining — lunch, return car, fly out to Chengdu.</li>
    </ul>
  </article>

  <hr class="my-8 dashed-divider" />

  <h2 class="font-display text-2xl font-bold mb-4">Pre-trip checklist</h2>
  <PaperCard padded={false}>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border-dash">
          <th class="py-2 px-3 text-left font-display font-semibold">Task</th>
          <th class="py-2 px-3 text-left font-display font-semibold whitespace-nowrap">Deadline</th>
          <th class="py-2 px-3 text-left font-display font-semibold">Who</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b border-border-dash">
          <td class="py-2 px-3">Book Mogao Caves (7 tickets, Jul 21 morning) at <a href="https://mgk.com.cn" target="_blank" class="text-vermillion-soft underline">mgk.com.cn</a></td>
          <td class="py-2 px-3 font-semibold whitespace-nowrap">Before April 18</td>
          <td class="py-2 px-3">Chinese members</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-2 px-3">Book Chaka Salt Lake tickets online</td>
          <td class="py-2 px-3 whitespace-nowrap">Before June</td>
          <td class="py-2 px-3">Chinese members</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-2 px-3">Book Dunhuang hotel (2 nights, Jul 20–22)</td>
          <td class="py-2 px-3 whitespace-nowrap">Before May</td>
          <td class="py-2 px-3">Anyone</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-2 px-3">Book all other hotels (Chaka, Dachaidan, Jiayuguan, Qilian)</td>
          <td class="py-2 px-3 whitespace-nowrap">Before June</td>
          <td class="py-2 px-3">Anyone</td>
        </tr>
        <tr>
          <td class="py-2 px-3">Confirm 7-seater rental + luggage solution in Xining</td>
          <td class="py-2 px-3 whitespace-nowrap">Before June</td>
          <td class="py-2 px-3">Anyone</td>
        </tr>
      </tbody>
    </table>
  </PaperCard>

  <hr class="my-8 dashed-divider" />

  <h2 class="font-display text-2xl font-bold mb-4">Budget per person</h2>
  <PaperCard padded={false}>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border-dash">
          <th class="py-2 px-3 text-left font-display font-semibold">Item</th>
          <th class="py-2 px-3 text-left font-display font-semibold whitespace-nowrap">Cost (¥)</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b border-border-dash">
          <td class="py-1.5 px-3">Chaka Salt Lake entry</td>
          <td class="py-1.5 px-3">~100</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-1.5 px-3">Mogao Caves entry</td>
          <td class="py-1.5 px-3">~238</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-1.5 px-3">Jiayuguan Fort + Overhanging Wall</td>
          <td class="py-1.5 px-3">~120</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-1.5 px-3">Qicai Danxia entry</td>
          <td class="py-1.5 px-3">~75</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-1.5 px-3">Mingsha Dunes + Crescent Moon Spring</td>
          <td class="py-1.5 px-3">~110</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-1.5 px-3">Camel ride (Mingsha)</td>
          <td class="py-1.5 px-3">~150</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-1.5 px-3">Horseback riding (Qilian)</td>
          <td class="py-1.5 px-3">~120</td>
        </tr>
        <tr class="border-b border-border-dash font-semibold">
          <td class="py-1.5 px-3">Tickets + activities total</td>
          <td class="py-1.5 px-3">~¥913</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-1.5 px-3">Accommodation (6 nights, budget–midrange)</td>
          <td class="py-1.5 px-3">~¥900–1,500</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-1.5 px-3">Food (7 days)</td>
          <td class="py-1.5 px-3">~¥700–1,000</td>
        </tr>
        <tr class="font-bold">
          <td class="py-1.5 px-3">Full trip estimate</td>
          <td class="py-1.5 px-3">¥2,500–3,400/person</td>
        </tr>
      </tbody>
    </table>
  </PaperCard>
  <p class="text-sm italic text-muted mt-2">Car rental and fuel split 7 ways adds approximately ¥400–600/person depending on vehicle.</p>

  <hr class="my-8 dashed-divider" />

  <h2 class="font-display text-2xl font-bold mb-2">Optional swaps & add-ons</h2>
  <p class="text-sm text-muted mb-4">Near the route but not in the main plan. Slot them in if energy/time/flexibility allow.</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    <PaperCard>
      <div class="flex items-baseline justify-between gap-2 mb-1">
        <span class="font-display font-semibold text-[15px]">
          <a href={`${base}northwest/taer-monastery`} class="no-underline text-inherit hover:text-vermillion-soft">Ta'er Monastery <span class="font-zh font-normal text-[13px] text-ink-soft">塔尔寺</span></a>
        </span>
        <span class="font-mono text-[10px] uppercase tracking-[.14em] text-muted whitespace-nowrap">2–3 hrs</span>
      </div>
      <div class="text-[12px] text-muted mb-1">Near Xining</div>
      <div class="text-[13px] text-ink-soft">26km from Xining. Visit the morning of Day 1 before departure, or as a pre-trip standalone activity.</div>
    </PaperCard>
    <PaperCard>
      <div class="flex items-baseline justify-between gap-2 mb-1">
        <span class="font-display font-semibold text-[15px]">
          <a href={`${base}northwest/yardang`} class="no-underline text-inherit hover:text-vermillion-soft">Yardang Geopark <span class="font-zh font-normal text-[13px] text-ink-soft">雅丹魔鬼城</span></a>
        </span>
        <span class="font-mono text-[10px] uppercase tracking-[.14em] text-muted whitespace-nowrap">Half day</span>
      </div>
      <div class="text-[12px] text-muted mb-1">Near Dunhuang</div>
      <div class="text-[13px] text-ink-soft">180km west of Dunhuang. Best at sunset. Requires an early start on Day 4 or a 3rd night in Dunhuang.</div>
    </PaperCard>
    <PaperCard>
      <div class="flex items-baseline justify-between gap-2 mb-1">
        <span class="font-display font-semibold text-[15px]">
          <a href={`${base}northwest/zhangye-dafo`} class="no-underline text-inherit hover:text-vermillion-soft">Giant Buddha Temple <span class="font-zh font-normal text-[13px] text-ink-soft">大佛寺</span></a>
        </span>
