---
import Base from '../../layouts/Base.astro';
import DayCard from '../../components/DayCard.astro';
import InteractiveMap from '../../components/InteractiveMap.astro';

const base = import.meta.env.BASE_URL;

const mapMarkers = [
  { name: 'Xining · 西宁', coords: [36.617, 101.767] as [number, number], color: '#2b6cb0', label: '🚄', phase: 'Start/End', dates: 'Jul 18 & 24', transport: '🚄 D2685 arrives 12:49pm' },
  { name: 'Riyueshan Pass · 日月山', coords: [36.517, 101.083] as [number, number], color: '#38a169', label: '1', phase: 'Day 1', dates: 'Jul 18', href: 'northwest/riyueshan' },
  { name: 'Qinghai Lake · 青海湖', coords: [36.9, 100.183] as [number, number], color: '#38a169', label: '2', phase: 'Day 1', dates: 'Jul 18', href: 'northwest/qinghai-lake' },
  { name: 'Chaka Salt Lake · 茶卡盐湖', coords: [36.717, 99.083] as [number, number], color: '#38a169', label: '3', phase: 'Days 1-2', dates: 'Jul 18-19', href: 'northwest/chaka-salt-lake' },
  { name: 'Delingha · 德令哈', coords: [37.367, 97.367] as [number, number], color: '#38a169', label: '4', phase: 'Day 2', dates: 'Jul 19', href: 'northwest/delingha' },
  { name: 'Feicui Hu · 翡翠湖', coords: [37.85, 95.367] as [number, number], color: '#38a169', label: '5', phase: 'Day 2', dates: 'Jul 19', href: 'northwest/feicui-hu' },
  { name: 'Dunhuang Night Market · 沙州夜市', coords: [40.142, 94.662] as [number, number], color: '#dd6b20', label: '6', phase: 'Day 3', dates: 'Jul 20', href: 'northwest/dunhuang-night-market' },
  { name: 'Mogao Caves · 莫高窟', coords: [40.038, 94.806] as [number, number], color: '#dd6b20', label: '7', phase: 'Day 4', dates: 'Jul 21', href: 'northwest/mogao-caves' },
  { name: 'Mingsha Dunes · 鸣沙山月牙泉', coords: [40.085, 94.674] as [number, number], color: '#dd6b20', label: '8', phase: 'Day 4', dates: 'Jul 21', href: 'northwest/mingsha-dunes' },
  { name: 'Jiayuguan Fort · 嘉峪关', coords: [39.817, 98.3] as [number, number], color: '#805ad5', label: '9', phase: 'Day 5', dates: 'Jul 22', href: 'northwest/jiayuguan-fort' },
  { name: 'Qicai Danxia · 七彩丹霞', coords: [38.937, 100.467] as [number, number], color: '#805ad5', label: '10', phase: 'Day 6', dates: 'Jul 23', href: 'northwest/qicai-danxia' },
  { name: 'Qilian Grassland · 祁连草原', coords: [38.183, 100.25] as [number, number], color: '#805ad5', label: '11', phase: 'Days 6-7', dates: 'Jul 23-24', href: 'northwest/qilian-grassland' },
  { name: 'Menyuan Flowers · 门源油菜花', coords: [37.383, 101.617] as [number, number], color: '#805ad5', label: '12', phase: 'Day 7', dates: 'Jul 24', href: 'northwest/menyuan-flowers' },
  // Optional stops
  { name: "Ta'er Monastery · 塔尔寺", coords: [36.479, 101.578] as [number, number], color: '#718096', label: '◆', phase: 'Optional · near Xining', href: 'northwest/taer-monastery', optional: true },
  { name: 'Yardang Geopark · 雅丹魔鬼城', coords: [40.525, 93.303] as [number, number], color: '#718096', label: '◆', phase: 'Optional · near Dunhuang', href: 'northwest/yardang', optional: true },
  { name: 'Giant Buddha Temple · 张掖大佛寺', coords: [38.936, 100.452] as [number, number], color: '#718096', label: '◆', phase: 'Optional · in Zhangye', href: 'northwest/zhangye-dafo', optional: true },
  { name: 'Shandan Horse Farm · 山丹军马场', coords: [38.560, 100.850] as [number, number], color: '#718096', label: '◆', phase: 'Optional · Day 6 route', href: 'northwest/shandan-horse-farm', optional: true },
  { name: 'Zhuoer Mountain · 卓尔山', coords: [38.204, 100.217] as [number, number], color: '#718096', label: '◆', phase: 'Optional · near Qilian', href: 'northwest/zhuoer-mountain', optional: true },
];

const mapLegend = [
  { color: '#2b6cb0', label: 'Start / End — Xining' },
  { color: '#38a169', label: 'Days 1–2 — Qinghai & Qaidam' },
  { color: '#dd6b20', label: 'Days 3–4 — Dunhuang' },
  { color: '#805ad5', label: 'Days 5–7 — Hexi Corridor & Qilian' },
  { color: '#718096', label: 'Optional stops', diamond: true },
];
---

<Base title="Northwest Road Trip · July 18–24">
  <h1 class="text-3xl font-bold mb-2">大西北 Road Trip · July 18–24, 2026</h1>
  <p class="text-gray-600 dark:text-gray-400 mb-1">
    <strong>Group:</strong> 7 people (5 Italians, 2 Chinese) · 1 car (7-seater) · Budget–midrange<br />
    <strong>Loop:</strong> Xining &rarr; Qinghai Lake &rarr; Chaka &rarr; Feicui Hu &rarr; Dunhuang &rarr; Jiayuguan &rarr; Danxia &rarr; Qilian &rarr; Xining
  </p>
  <p class="text-sm text-gray-500 dark:text-gray-400 mt-2 space-x-2">
    <a href={`${base}`} class="text-blue-700 dark:text-blue-400 hover:underline">&larr; Full Trip Overview</a>
    <span>&middot;</span>
    <a href={`${base}resources/tips`} class="text-blue-700 dark:text-blue-400 hover:underline">Travel Tips</a>
    <span>&middot;</span>
    <a href={`${base}resources/packing-list`} class="text-blue-700 dark:text-blue-400 hover:underline">Packing List</a>
    <span>&middot;</span>
    <a href={`${base}resources/useful-phrases`} class="text-blue-700 dark:text-blue-400 hover:underline">Useful Chinese Phrases</a>
    <span>&middot;</span>
    <a href={`${base}map`} class="text-blue-700 dark:text-blue-400 hover:underline">Route Maps</a>
  </p>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <!-- Trip Overview Grid -->
  <h2 class="text-2xl font-bold mb-4">Trip Overview</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    <DayCard
      day={1}
      date="Jul 18"
      temp="15–20°C"
      route="&#128663; Xining → Chaka · 300km / 4h"
      highlights={[
        { name: 'Riyueshan', href: 'northwest/riyueshan', imageQuery: 'Riyueshan Pass 日月山 Qinghai' },
        { name: 'Qinghai Lake', href: 'northwest/qinghai-lake', imageQuery: 'Qinghai Lake 青海湖' },
        { name: 'Chaka', href: 'northwest/chaka-salt-lake', imageQuery: 'Chaka Salt Lake 茶卡盐湖' },
      ]}
      accommodation="&#128719; Chaka"
      phase="green"
    />
    <DayCard
      day={2}
      date="Jul 19"
      temp="20–28°C"
      route="&#128663; Chaka → Dachaidan · 330km / 4h"
      highlights={[
        { name: 'Chaka sunrise', href: 'northwest/chaka-salt-lake', imageQuery: 'Chaka Salt Lake 茶卡盐湖' },
        { name: 'Delingha', href: 'northwest/delingha', imageQuery: 'Delingha 德令哈 Qinghai' },
        { name: 'Feicui Hu', href: 'northwest/feicui-hu', imageQuery: 'Feicui Hu 翡翠湖 Dachaidan' },
      ]}
      accommodation="&#128719; Dachaidan"
      phase="green"
    />
    <DayCard
      day={3}
      date="Jul 20"
      temp="38–42°C"
      route="&#128663; Dachaidan → Dunhuang · 500km / 6h"
      highlights={[
        { name: 'Qaidam Basin desert highway' },
        { name: 'Night Market', href: 'northwest/dunhuang-night-market', imageQuery: 'Dunhuang Night Market 敦煌夜市' },
      ]}
      accommodation="&#128719; Dunhuang"
      phase="orange"
    />
    <DayCard
      day={4}
      date="Jul 21"
      temp="38–42°C"
      route="&#127957; Dunhuang full day"
      highlights={[
        { name: 'Mogao Caves', href: 'northwest/mogao-caves', imageQuery: 'Mogao Caves 莫高窟 Dunhuang' },
        { name: 'Mingsha Dunes', href: 'northwest/mingsha-dunes', imageQuery: 'Mingsha Dunes 鸣沙山 Dunhuang' },
      ]}
      accommodation="&#128719; Dunhuang"
      phase="orange"
    />
    <DayCard
      day={5}
      date="Jul 22"
      temp="30–35°C"
      route="&#128663; Dunhuang → Jiayuguan · 400km / 4.5h"
      highlights={[
        { name: 'Jiayuguan Fort', href: 'northwest/jiayuguan-fort', imageQuery: 'Jiayuguan Fort 嘉峪关' },
        { name: 'Overhanging Wall' },
      ]}
      accommodation="&#128719; Jiayuguan"
      phase="purple"
    />
    <DayCard
      day={6}
      date="Jul 23"
      temp="20–25°C"
      route="&#128663; Jiayuguan → Qilian · 410km / 5.5h"
      highlights={[
        { name: 'Qicai Danxia', href: 'northwest/qicai-danxia', imageQuery: 'Qicai Danxia 七彩丹霞 Zhangye' },
        { name: 'Qilian grassland', href: 'northwest/qilian-grassland', imageQuery: 'Qilian Grassland 祁连草原' },
      ]}
      accommodation="&#128719; Qilian"
      phase="purple"
    />
    <DayCard
      day={7}
      date="Jul 24"
      temp="20–25°C"
      route="&#128663; Qilian → Xining · 280km / 3.5h"
      highlights={[
        { name: 'Horseback riding', href: 'northwest/qilian-grassland', imageQuery: 'Qilian Grassland 祁连草原' },
        { name: 'Menyuan flowers', href: 'northwest/menyuan-flowers', imageQuery: 'Menyuan Rapeseed Flowers 门源油菜花' },
      ]}
      accommodation="&#127968; Back to Xining"
      phase="purple"
    />
  </div>
  <p class="text-[13px] text-gray-400 mt-2">Total ~2,220km · <a href="#route-map" class="text-blue-600 hover:underline">View Route Map</a></p>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <!-- Route Map -->
  <span id="route-map"></span>
  <h2 class="text-2xl font-bold mb-4">Route Map</h2>
  <InteractiveMap
    id="northwest-map"
    markers={mapMarkers}
    legend={mapLegend}
    center={[38.5, 98]}
    zoom={6}
  />

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <!-- Day 1 -->
  <span id="day-1"></span>
  <h2 class="text-2xl font-bold mb-2">Day 1 — July 18 · Xining &rarr; Qinghai Lake &rarr; Chaka</h2>
  <p class="text-sm italic text-gray-500 dark:text-gray-400 mb-4">300km · 4h driving · Sleep: Chaka · 15–20°C</p>

  <ul class="space-y-3 text-[15px]">
    <li>
      <strong>12:49pm</strong> Arrive Xining by D2685 from Xi'an North. Lunch near station.
    </li>
    <li>
      <strong>2:00pm</strong> Pick up car, depart Xining
    </li>
    <li>
      <strong>3:30pm</strong>
      <a href={`${base}northwest/riyueshan`} class="text-blue-700 dark:text-blue-400 hover:underline font-semibold">Riyueshan Pass (日月山)</a>
      (3,520m) — 20-min stop, photo, move on
    </li>
    <li>
      <strong>4:15pm</strong>
      <a href={`${base}northwest/qinghai-lake`} class="text-blue-700 dark:text-blue-400 hover:underline font-semibold">Qinghai Lake (青海湖)</a>
      north shore (Erlangjian) — 1.5hrs, walk the shore
    </li>
    <li>
      <strong>6:00pm</strong> Drive to Chaka (~170km, 2hrs)
    </li>
    <li>
      <strong>8:00pm</strong> Arrive Chaka, dinner, overnight
    </li>
  </ul>

  <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4 my-4">
    <p class="text-sm text-blue-900 dark:text-blue-200">
      <strong>Tonight:</strong> Set alarm for 6am. Chaka mirror reflection only works at sunrise when the wind is still.
    </p>
  </div>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <!-- Day 2 -->
  <span id="day-2"></span>
  <h2 class="text-2xl font-bold mb-2">Day 2 — July 19 · Chaka &rarr; Delingha &rarr; Feicui Hu</h2>
  <p class="text-sm italic text-gray-500 dark:text-gray-400 mb-4">330km · 4h driving · Sleep: Dachaidan · 20–28°C</p>

  <ul class="space-y-3 text-[15px]">
    <li>
      <strong>6:00am</strong>
      <a href={`${base}northwest/chaka-salt-lake`} class="text-blue-700 dark:text-blue-400 hover:underline font-semibold">Chaka Salt Lake (茶卡盐湖)</a>
      at sunrise — the mirror reflection. 1.5hrs
    </li>
    <li>
      <strong>8:00am</strong> Breakfast, pack up
    </li>
    <li>
      <strong>8:30am</strong> Drive to Delingha (~230km, 2.5hrs)
    </li>
    <li>
      <strong>11:00am</strong> Delingha — lunch, 30min walk at
      <a href={`${base}northwest/delingha`} class="text-blue-700 dark:text-blue-400 hover:underline font-semibold">Haizi Poetry Park</a>
    </li>
    <li>
      <strong>1:00pm</strong> Drive to Feicui Hu / Dachaidan (~100km, 1hr)
    </li>
    <li>
      <strong>2:00pm</strong>
      <a href={`${base}northwest/feicui-hu`} class="text-blue-700 dark:text-blue-400 hover:underline font-semibold">Feicui Hu (翡翠湖)</a>
      colored lakes — 2hrs wandering
    </li>
    <li>
      <strong>4:30pm</strong> Check in Dachaidan, rest, early dinner
    </li>
  </ul>

  <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4 my-4">
    <p class="text-sm text-blue-900 dark:text-blue-200">
      <strong>Tonight:</strong> Driver fills tank completely before sleeping — the Qaidam Basin to Dunhuang has sparse fuel stations.
    </p>
  </div>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <!-- Day 3 -->
  <span id="day-3"></span>
  <h2 class="text-2xl font-bold mb-2">Day 3 — July 20 · Dachaidan &rarr; Dunhuang · The Desert Highway</h2>
  <p class="text-sm italic text-gray-500 dark:text-gray-400 mb-4">500km · 6h driving · Sleep: Dunhuang · 38–42°C</p>

  <ul class="space-y-3 text-[15px]">
    <li>
      <strong>8:00am</strong> Depart Dachaidan, full tank
    </li>
    <li>
      <strong>8:00am–2:00pm</strong> Qaidam Basin highway — one of the great desert drives in China. Flat salt pans stretching to the horizon, distant mountain ranges floating above the heat shimmer, almost no traffic. Stop anywhere for photos — the emptiness is the point.
    </li>
    <li>
      <strong>2:30pm</strong> Arrive Dunhuang, check in (2 nights), rest — it's 40°C outside
    </li>
    <li>
      <strong>7:00pm</strong>
      <a href={`${base}northwest/dunhuang-night-market`} class="text-blue-700 dark:text-blue-400 hover:underline font-semibold">沙州夜市 (Shazhou Night Market)</a>
      — first real taste of Silk Road street food. Allow 1.5hrs.
    </li>
  </ul>

  <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4 my-4">
    <p class="text-sm text-blue-900 dark:text-blue-200">
      <strong>Tonight:</strong> Confirm Mogao Caves booking for tomorrow morning. Tickets at <a href="https://mgk.com.cn" target="_blank" class="underline">mgk.com.cn</a>.
    </p>
  </div>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <!-- Day 4 -->
  <span id="day-4"></span>
  <h2 class="text-2xl font-bold mb-2">Day 4 — July 21 · Dunhuang Full Day</h2>
  <p class="text-sm italic text-gray-500 dark:text-gray-400 mb-4">Sleep: Dunhuang · 38–42°C</p>

  <ul class="space-y-3 text-[15px]">
    <li>
      <strong>8:00am</strong>
      <a href={`${base}northwest/mogao-caves`} class="text-blue-700 dark:text-blue-400 hover:underline font-semibold">Mogao Caves (莫高窟)</a>
      — pre-booked morning slot, guided tour ~3hrs. Finish by 11am.
    </li>
    <li>
      <strong>12:00pm</strong> Lunch, long rest indoors — do not be outside between noon and 5pm
    </li>
    <li>
      <strong>5:30pm</strong>
      <a href={`${base}northwest/mingsha-dunes`} class="text-blue-700 dark:text-blue-400 hover:underline font-semibold">Crescent Moon Spring (月牙泉)</a>
      — walk to the spring first while light is still high
    </li>
    <li>
      <strong>6:30pm</strong> Mingsha Sand Dunes — camel ride at golden hour (~&yen;150/person), watch sunset from the ridge
    </li>
    <li>
      <strong>8:30pm</strong> Dinner, night market
    </li>
  </ul>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <!-- Day 5 -->
  <span id="day-5"></span>
  <h2 class="text-2xl font-bold mb-2">Day 5 — July 22 · Dunhuang &rarr; Jiayuguan</h2>
  <p class="text-sm italic text-gray-500 dark:text-gray-400 mb-4">400km · 4.5h driving · Sleep: Jiayuguan · 30–35°C</p>

  <ul class="space-y-3 text-[15px]">
    <li>
      <strong>8:00am</strong> Depart Dunhuang
    </li>
    <li>
      <strong>12:30pm</strong> Arrive Jiayuguan, lunch
    </li>
    <li>
      <strong>2:00pm</strong>
      <a href={`${base}northwest/jiayuguan-fort`} class="text-blue-700 dark:text-blue-400 hover:underline font-semibold">Jiayuguan Fort (嘉峪关)</a>
      — western end of the Great Wall, "Greatest Pass Under Heaven." Walk the full wall circuit. 2hrs.
    </li>
    <li>
      <strong>4:30pm</strong> Overhanging Great Wall (悬壁长城) — 10km north of the fort, a section of wall that climbs vertically up a mountain face. Different in character from the fort. 45min. <em>(Optional but strongly recommended — fits the afternoon easily)</em>
    </li>
    <li>
      <strong>Evening</strong> Dinner, overnight Jiayuguan
    </li>
  </ul>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <!-- Day 6 -->
  <span id="day-6"></span>
  <h2 class="text-2xl font-bold mb-2">Day 6 — July 23 · Jiayuguan &rarr; Qicai Danxia &rarr; Qilian</h2>
  <p class="text-sm italic text-gray-500 dark:text-gray-400 mb-4">460km · 6h driving · Sleep: Qilian · 20–25°C</p>

  <ul class="space-y-3 text-[15px]">
    <li>
      <strong>8:00am</strong> Depart Jiayuguan
    </li>
    <li>
      <strong>10:30am</strong> Arrive
      <a href={`${base}northwest/qicai-danxia`} class="text-blue-700 dark:text-blue-400 hover:underline font-semibold">Zhangye Qicai Danxia (七彩丹霞)</a>
      — morning light is ideal for the colors. Take the shuttle buses between platforms. 2.5hrs.
    </li>
    <li>
      <strong>1:30pm</strong> Lunch in Zhangye
    </li>
    <li>
      <strong>2:30pm</strong> Drive south to Qilian County via G227 (~180km, 2.5hrs) — direct mountain route, no backtracking
    </li>
    <li>
      <strong>5:00pm</strong> Arrive
      <a href={`${base}northwest/qilian-grassland`} class="text-blue-700 dark:text-blue-400 hover:underline font-semibold">Qilian County</a>, check in, riverside walk at dusk
    </li>
    <li>
      <strong>Evening</strong> Lamb hotpot dinner — Qilian lamb is among the best in Qinghai
    </li>
  </ul>

  <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4 my-4">
    <p class="text-sm text-blue-900 dark:text-blue-200">
      <strong>Tonight:</strong> Ask hotel to arrange 7 horses for 8:00am tomorrow.
    </p>
  </div>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <!-- Day 7 -->
  <span id="day-7"></span>
  <h2 class="text-2xl font-bold mb-2">Day 7 — July 24 · Qilian &rarr; Menyuan &rarr; Xining</h2>
  <p class="text-sm italic text-gray-500 dark:text-gray-400 mb-4">280km · 3.5h driving</p>

  <ul class="space-y-3 text-[15px]">
    <li>
      <strong>8:00am</strong> 1hr horseback ride on the grassland (~&yen;120/person). Bring a warm layer — 2,800m at 8am is cold.
    </li>
    <li>
      <strong>9:30am</strong> Depart Qilian east on S302
    </li>
    <li>
      <strong>11:00am</strong>
      <a href={`${base}northwest/menyuan-flowers`} class="text-blue-700 dark:text-blue-400 hover:underline font-semibold">Menyuan rapeseed flower fields (门源油菜花)</a>
      — 30min stop if in bloom. The yellow fields with snow peaks behind are the perfect farewell image.
    </li>
    <li>
      <strong>12:00pm</strong> Continue north on G227 to Xining (~160km, 2hrs)
    </li>
    <li>
      <strong>2:00pm</strong> Arrive Xining — lunch, return car, train home
    </li>
  </ul>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <!-- Pre-Trip Checklist -->
  <h2 class="text-2xl font-bold mb-4">Pre-Trip Checklist</h2>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-300 dark:border-gray-600">
          <th class="py-2 pr-4 text-left font-semibold">Task</th>
          <th class="py-2 pr-4 text-left font-semibold">Deadline</th>
          <th class="py-2 text-left font-semibold">Who</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b border-gray-200 dark:border-gray-700">
          <td class="py-2 pr-4">Book Mogao Caves (7 tickets, Jul 21 morning) at <a href="https://mgk.com.cn" target="_blank" class="text-blue-700 dark:text-blue-400 underline">mgk.com.cn</a></td>
          <td class="py-2 pr-4 font-semibold">Before April 18</td>
          <td class="py-2">Chinese members</td>
        </tr>
        <tr class="border-b border-gray-200 dark:border-gray-700">
          <td class="py-2 pr-4">Book Chaka Salt Lake tickets online</td>
          <td class="py-2 pr-4">Before June</td>
          <td class="py-2">Chinese members</td>
        </tr>
        <tr class="border-b border-gray-200 dark:border-gray-700">
          <td class="py-2 pr-4">Book Dunhuang hotel (2 nights, Jul 20–22)</td>
          <td class="py-2 pr-4">Before May</td>
          <td class="py-2">Anyone</td>
        </tr>
        <tr class="border-b border-gray-200 dark:border-gray-700">
