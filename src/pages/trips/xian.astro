---
import Base from '../../layouts/Base.astro';
import InteractiveMap from '../../components/InteractiveMap.astro';
import SplitView from '../../components/SplitView.astro';
import DayCard from '../../components/DayCard.astro';
import PaperCard from '../../components/primitives/PaperCard.astro';
import Stamp from '../../components/primitives/Stamp.astro';
import Marginalia from '../../components/primitives/Marginalia.astro';
import { tripDays, locations } from '../../data/locations';

const base = import.meta.env.BASE_URL;
const phaseDays = tripDays.filter(d => d.phaseNum === 2);

const mapMarkers = [
  { name: "Xi'an Station · 西安站", coords: [34.271, 108.952] as [number, number], color: 'var(--color-muted)', label: '🚄', phase: 'Arrival', dates: 'Jul 17', transport: '🚄 T231 arrives 7:35am' },
  { name: 'Terracotta Warriors · 秦始皇兵马俑', coords: [34.384, 109.278] as [number, number], color: 'var(--color-phase-xian)', label: '1', phase: 'Day 1', dates: 'Jul 17', href: 'xian/terracotta-warriors' },
  { name: 'City Wall South Gate · 永宁门', coords: [34.262, 108.946] as [number, number], color: 'var(--color-vermillion-soft)', label: '2', phase: 'Day 1', dates: 'Jul 17', href: 'xian/city-wall' },
  { name: 'Bell Tower · 钟楼', coords: [34.260, 108.942] as [number, number], color: 'var(--color-vermillion-soft)', label: '3', phase: 'Day 1', dates: 'Jul 17' },
  { name: 'Drum Tower · 鼓楼', coords: [34.261, 108.938] as [number, number], color: 'var(--color-vermillion-soft)', label: '4', phase: 'Day 1', dates: 'Jul 17' },
  { name: 'Muslim Quarter · 回民街', coords: [34.265, 108.940] as [number, number], color: 'var(--color-phase-xian)', label: '5', phase: 'Day 1', dates: 'Jul 17', href: 'xian/muslim-quarter' },
  { name: 'Great Mosque · 大清真寺', coords: [34.264, 108.937] as [number, number], color: 'var(--color-phase-xian)', label: '6', phase: 'Day 1', dates: 'Jul 17' },
  { name: '大唐不夜城 · Great Tang All Day Mall', coords: [34.220, 108.961] as [number, number], color: 'var(--color-phase-xian)', label: '7', phase: 'Day 1', dates: 'Jul 17', href: 'xian/tang-all-day-mall' },
  // Optional stops
  { name: 'Big Wild Goose Pagoda · 大雁塔', coords: [34.218, 108.959] as [number, number], color: 'var(--color-muted)', label: '◆', phase: 'Optional · swap City Wall', optional: true },
  { name: 'Shaanxi History Museum · 陕西历史博物馆', coords: [34.224, 108.955] as [number, number], color: 'var(--color-muted)', label: '◆', phase: 'Optional · near Pagoda', optional: true },
  { name: 'Tang Paradise · 大唐芙蓉园', coords: [34.210, 108.964] as [number, number], color: 'var(--color-muted)', label: '◆', phase: 'Optional · evening alternative', optional: true },
];

// Build highlight items per day from destination slugs, using locations.name for display.
function highlightsForDay(slugs: string[]) {
  return slugs
    .map(s => locations[s])
    .filter(Boolean)
    .map(l => ({ name: l.name, href: l.slug }));
}
---

<Base title="Xi'an · 西安 · July 17">

  <header class="mb-4">
    <a href={base} class="text-sm text-muted hover:text-vermillion-soft">← Full trip overview</a>
    <h1 class="font-display italic font-semibold text-[36px] leading-none mt-2">
      Xi'an <span class="font-zh not-italic text-[28px] text-ink-soft">西安</span>
    </h1>
    <div class="font-mono uppercase text-[11px] tracking-[.14em] text-muted mt-1">PHASE 2 · JUL 17 · 8 PEOPLE</div>
    <p class="mt-3 max-w-prose text-[14px] text-ink-soft">
      Base in Xi'an city centre near the Bell Tower. The 2 new group members join here. Train to Lintong for Terracotta Warriors in the morning; Didi + walking + cycling in the old city the rest of the day.
    </p>
  </header>

  <SplitView phaseKey="xian">
    <div slot="map" class="h-full">
      <InteractiveMap id="xian-map" markers={mapMarkers} center={[34.28, 108.96]} zoom={11} height="100%" />
    </div>

    <div slot="list">
      {phaseDays.map(d => (
        <DayCard
          day={d.dayInTrip}
          dayInPhase={d.dayInPhase}
          date={d.date}
          headline={d.headline}
          headlineIt={d.headlineIt}
          route="🚄 arrive 07:35 · ~1 day in town · D2685 dep 09:00 next morning"
          highlights={highlightsForDay(d.destinationSlugs)}
          accommodation="Bell Tower area"
          note="meet 2 new members at Xi'an Station"
          anchorId={`day-${d.dayInTrip}`}
        />
      ))}

      <PaperCard class="mt-6 bg-paper">
        <Stamp rotate={-3}>book now</Stamp>
        <ul class="list-disc pl-5 mt-3 text-[13px] space-y-1">
          <li><strong>Terracotta Warriors tickets</strong> — ¥120/person, sells out in peak July → book via official WeChat mini-program</li>
          <li><strong>7006 Xi'an → Lintong (Jul 17 morning)</strong> — 8 people, departs 8:12am → <a href="https://www.12306.cn" target="_blank" class="text-vermillion-soft underline">12306.cn</a></li>
          <li><strong>D2685 Xi'an North → Xining (Jul 18)</strong> — 8 people, departs 9:00am → <a href="https://www.12306.cn" target="_blank" class="text-vermillion-soft underline">12306.cn</a></li>
          <li><strong>Hotel</strong> — near Bell Tower for walking access to City Wall and Muslim Quarter</li>
        </ul>
        <Marginalia position="br" rotate={-2}>do this first!!</Marginalia>
      </PaperCard>
    </div>
  </SplitView>

  <hr class="my-8 dashed-divider" />

  <h2 class="font-display text-2xl font-bold mb-4">Day-by-day detail</h2>

  <article class="prose">
    <h3 id="morning">Morning · Terracotta Warriors</h3>
    <p class="italic text-muted">Arrive Xi'an 7:35am · 7006 train to Lintong at 8:12am · 28–38°C</p>
    <ul>
      <li><strong>7:35am</strong> Arrive Xi'an Station by <strong>T231</strong> night train from Beijing.</li>
      <li><strong>7:35–8:00am</strong> Meet the 2 new group members at the station. Grab breakfast at a street stall near the station — <strong>肉夹馍 (roujiamo)</strong> and <strong>胡辣汤 (hulatang, spicy pepper soup)</strong> — the local morning combo.</li>
      <li><strong>8:12am</strong> Board <strong>7006</strong> train from Xi'an Station to Lintong (临潼) — short ride east.</li>
      <li><strong>~9:30am–12:30pm</strong> <a href={`${base}xian/terracotta-warriors`}>Terracotta Warriors (秦始皇兵马俑博物馆)</a> — Pit 1 first (the big one, ~6,000 warriors in formation), then Pit 2 and 3, then the Bronze Chariots Exhibition Hall. Hire an English-speaking guide at the entrance (¥150–200 for the group). Allow 3 hours.</li>
      <li><strong>12:30pm</strong> Train back to Xi'an city centre.</li>
    </ul>
    <p class="text-[13px] text-ink-soft border-l-2 border-border-dash pl-3 italic">
      Tip: Arrive before 10am to beat the tour bus crowds. Skip the "factory" shops on the approach road — they are tourist traps.
    </p>

    <h3 id="afternoon">Afternoon · City Wall & Landmarks</h3>
    <p class="italic text-muted">Back in the old city · hot — bring water</p>
    <ul>
      <li><strong>1:30pm</strong> Check into hotel near Bell Tower. Drop bags, freshen up.</li>
      <li><strong>2:00pm</strong> Lunch: <strong>魏家凉皮 (Weijia Liangpi)</strong> — fast, cheap, excellent cold noodles (凉皮) and roujiamo. A local chain, no frills.</li>
      <li><strong>3:00–5:00pm</strong> <a href={`${base}xian/city-wall`}>Xi'an City Wall (西安城墙)</a> — enter at South Gate (永宁门). Rent bikes (¥45/3h single, ¥90/3h tandem). Ride the full 13.7km loop — flat, paved, panoramic views of the old city. Return bikes at any gate. ~1.5–2 hours.</li>
      <li><strong>5:00–5:30pm</strong> Walk to <strong>Bell Tower (钟楼)</strong> and <strong>Drum Tower (鼓楼)</strong> — photo stop from the plaza. The Drum Tower sits right at the entrance to the Muslim Quarter. No need to go inside unless the group is keen (¥30 combo ticket for both towers).</li>
    </ul>

    <h3 id="evening">Evening · Muslim Quarter & Tang Mall</h3>
    <p class="italic text-muted">The Drum Tower marks the entrance — walk straight in</p>
    <ul>
      <li><strong>5:30–7:30pm</strong> <a href={`${base}xian/muslim-quarter`}>Muslim Quarter (回民街)</a> — street food dinner crawl. This is not a sit-down meal: graze from stall to stall.
        <ul>
          <li><strong>Must-try:</strong> 羊肉泡馍 (lamb &amp; bread soup) · 肉夹馍 (meat in flatbread) · 烤羊肉串 (cumin lamb skewers) · 凉皮 (cold noodles) · 石榴汁 (pomegranate juice) · 镜糕 (mini rice cakes)</li>
        </ul>
      </li>
      <li><strong>6:30pm</strong> Side trip: <strong>Great Mosque (大清真寺)</strong> — ¥25 entry. One of China's oldest mosques, built in Chinese garden style with Islamic elements. A peaceful contrast to the street chaos. 20–30 minutes.</li>
      <li><strong>8:00pm</strong> Didi to <a href={`${base}xian/tang-all-day-mall`}>大唐不夜城 (Great Tang All Day Mall)</a> — ~15min taxi south. A 2km pedestrian boulevard lit up in full Tang Dynasty spectacle: golden light installations, costumed street performers, live music, and the famous roly-poly lady. Walk the boulevard from the Big Wild Goose Pagoda south. Best after dark — peak atmosphere by 8:30pm.</li>
      <li><strong>9:30pm</strong> Didi back to hotel. Rest up — D2685 to Xining departs Xi'an North at 9:00am tomorrow.</li>
    </ul>
  </article>

  <hr class="my-8 dashed-divider" />

  <h2 class="font-display text-2xl font-bold mb-2">Optional swaps & add-ons</h2>
  <p class="text-sm text-muted mb-4">Near the route but not in the main plan. Slot them in if energy/time allow.</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    <PaperCard>
      <div class="flex items-baseline justify-between gap-2 mb-1">
        <span class="font-display font-semibold text-[15px]">Big Wild Goose Pagoda <span class="font-zh font-normal text-[13px] text-ink-soft">大雁塔</span></span>
        <span class="font-mono text-[10px] uppercase tracking-[.14em] text-muted whitespace-nowrap">1 hr</span>
      </div>
      <div class="text-[12px] text-muted mb-1">South of old city · swap for City Wall</div>
      <div class="text-[13px] text-ink-soft">Tang Dynasty Buddhist pagoda. The fountain plaza in front has Asia's largest musical fountain show (8:30pm in summer). Worth a detour if the group prefers temples to cycling.</div>
    </PaperCard>
    <PaperCard>
      <div class="flex items-baseline justify-between gap-2 mb-1">
        <span class="font-display font-semibold text-[15px]">Shaanxi History Museum <span class="font-zh font-normal text-[13px] text-ink-soft">陕西历史博物馆</span></span>
        <span class="font-mono text-[10px] uppercase tracking-[.14em] text-muted whitespace-nowrap">2 hrs</span>
      </div>
      <div class="text-[12px] text-muted mb-1">Near Big Wild Goose Pagoda · add to afternoon</div>
      <div class="text-[13px] text-ink-soft">One of China's best museums: 370,000+ artefacts spanning 1 million years. Free entry (book online). Pair with the Pagoda if you skip the City Wall.</div>
    </PaperCard>
    <PaperCard>
      <div class="flex items-baseline justify-between gap-2 mb-1">
        <span class="font-display font-semibold text-[15px]">Tang Paradise <span class="font-zh font-normal text-[13px] text-ink-soft">大唐芙蓉园</span></span>
        <span class="font-mono text-[10px] uppercase tracking-[.14em] text-muted whitespace-nowrap">1.5 hrs</span>
      </div>
      <div class="text-[12px] text-muted mb-1">Near Big Wild Goose Pagoda · evening</div>
      <div class="text-[13px] text-ink-soft">Reconstructed Tang Dynasty theme park with evening light shows. More impressive at night. Free entry (book online). An alternative evening if the Muslim Quarter doesn't appeal.</div>
    </PaperCard>
  </div>

  <hr class="my-8 dashed-divider" />

  <h2 class="font-display text-2xl font-bold mb-4">Practical notes</h2>
  <PaperCard padded={false}>
    <table class="w-full text-sm">
      <tbody>
        <tr class="border-b border-border-dash">
          <td class="py-2 px-3 font-display font-semibold whitespace-nowrap align-top w-32">Weather</td>
          <td class="py-2 px-3">July: 28–38°C, dry heat. Hotter than Beijing. Sunscreen, hat, and water bottle essential — especially at the Terracotta Warriors and on the City Wall.</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-2 px-3 font-display font-semibold whitespace-nowrap align-top">Transport</td>
          <td class="py-2 px-3">Train from Xi'an Station to Lintong for the Terracotta Warriors. Didi and metro for getting around the old city.</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-2 px-3 font-display font-semibold whitespace-nowrap align-top">Payment</td>
          <td class="py-2 px-3">WeChat Pay / Alipay everywhere. Same setup as Beijing.</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-2 px-3 font-display font-semibold whitespace-nowrap align-top">Language</td>
          <td class="py-2 px-3">Less English than Beijing outside major sights. Your Chinese friends handle logistics.</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-2 px-3 font-display font-semibold whitespace-nowrap align-top">Terracotta Warriors</td>
          <td class="py-2 px-3">40km east — take the train from Xi'an Station to Lintong, then a short taxi to the museum. Book museum tickets online in advance.</td>
        </tr>
        <tr class="border-b border-border-dash">
          <td class="py-2 px-3 font-display font-semibold whitespace-nowrap align-top">City Wall</td>
          <td class="py-2 px-3">Closes 7pm (last entry 6:30pm). Bikes must be returned by closing. Bring water — no shade on much of the wall.</td>
        </tr>
        <tr>
          <td class="py-2 px-3 font-display font-semibold whitespace-nowrap align-top">Muslim Quarter</td>
          <td class="py-2 px-3">All food is halal (no pork). Busiest after 5pm. Keep the group together — the lanes are narrow and crowded.</td>
        </tr>
      </tbody>
    </table>
  </PaperCard>

  <hr class="my-8 dashed-divider" />

  <h2 class="font-display text-2xl font-bold mb-2">Onward</h2>
  <p class="text-[15px]">
    <strong>July 18 morning</strong> → D2685 Xi'an North 9:00am → Xining 12:49pm
  </p>
  <p class="text-sm mt-3 space-x-2">
    <a href={`${base}trips/beijing`} class="text-vermillion-soft hover:underline">← Phase 1 · Beijing</a>
    <span class="text-muted">·</span>
    <a href={base} class="text-vermillion-soft hover:underline">Full trip overview</a>
    <span class="text-muted">·</span>
    <a href={`${base}trips/northwest`} class="text-vermillion-soft hover:underline">Phase 3 · Northwest →</a>
  </p>
</Base>
