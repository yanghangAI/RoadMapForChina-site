---
interface Props {
  /** Used as the localStorage key suffix */
  phaseKey: string;
}
const { phaseKey } = Astro.props;
const stateKey = `splitview:${phaseKey}`;
---
<div
  class="split-view grid lg:grid-cols-[45%_1fr] gap-0 lg:gap-4"
  data-state-key={stateKey}
>
  <div class="split-map-wrap sticky top-14 z-20 lg:top-16 lg:self-start lg:max-h-[calc(100vh-5rem)] bg-paper">
    <div class="split-map relative h-[34vh] lg:h-[calc(100vh-5rem)]">
      <div class="map-slot absolute inset-0">
        <slot name="map" />
      </div>
    </div>

    <!-- Floating size cycler — lives inside the map's top-right corner -->
    <div class="map-cycler absolute top-2 right-2 z-[1100] flex flex-col gap-1">
      <button type="button" class="map-shrink w-8 h-8 grid place-items-center bg-paper-card/95 border border-border paper-card-shadow hover:bg-paper transition-colors text-ink" aria-label="Smaller map">
        <svg viewBox="0 0 12 12" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M2 8 L6 4 L10 8 Z"/></svg>
      </button>
      <button type="button" class="map-grow w-8 h-8 grid place-items-center bg-paper-card/95 border border-border paper-card-shadow hover:bg-paper transition-colors text-ink" aria-label="Bigger map">
        <svg viewBox="0 0 12 12" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M2 4 L6 8 L10 4 Z"/></svg>
      </button>
    </div>
  </div>

  <div class="split-list">
    <slot name="list" />
  </div>
</div>

<style>
  /* Map hidden: collapse the map area to a thin paper strip; cycler still visible */
  .split-view.map-hidden .split-map {
    height: 40px;
    border-bottom: 1px dashed var(--color-border-dash);
  }
  .split-view.map-hidden .split-map .map-slot { display: none; }
  .split-view.map-hidden .map-shrink { display: none; }

  /* List hidden: list collapses, map fills the viewport, only shrink is offered */
  .split-view.list-hidden .split-list { display: none; }
  .split-view.list-hidden .split-map { height: calc(100vh - 5rem); }
  .split-view.list-hidden .map-grow { display: none; }

  /* Day cards keep clear of the sticky map when the page jumps to them */
  .split-view .day-card { scroll-margin-top: calc(3.5rem + 34vh + 1rem); }
  @media (min-width: 1024px) {
    .split-view .day-card { scroll-margin-top: 5rem; }
  }
</style>

<script is:inline define:vars={{ stateKey }}>
  (function() {
    const view = document.querySelector(`[data-state-key="${stateKey}"]`);
    if (!view) return;
    const saved = localStorage.getItem(stateKey);
    if (saved === 'map-hidden') view.classList.add('map-hidden');
    if (saved === 'list-hidden') view.classList.add('list-hidden');

    function setState(s) {
      view.classList.remove('map-hidden', 'list-hidden');
      if (s) view.classList.add(s);
      if (s) localStorage.setItem(stateKey, s); else localStorage.removeItem(stateKey);
      window.dispatchEvent(new Event('resize'));
    }

    // ▲ shrink: full → normal → hide
    function shrink() {
      if (view.classList.contains('list-hidden')) setState(null);
      else if (!view.classList.contains('map-hidden')) setState('map-hidden');
    }
    // ▼ grow: hide → normal → full
    function grow() {
      if (view.classList.contains('map-hidden')) setState(null);
      else if (!view.classList.contains('list-hidden')) setState('list-hidden');
    }

    view.querySelector('.map-shrink')?.addEventListener('click', shrink);
    view.querySelector('.map-grow')?.addEventListener('click', grow);

    // Day-card → map coordination
    view.querySelectorAll('.day-card[id^="day-"]').forEach(card => {
      card.style.cursor = 'pointer';
      card.addEventListener('click', (e) => {
        if (e.target.closest('a, button')) return;
        const dayId = card.id;
        const maps = window.__maps || {};
        Object.keys(maps).forEach(mapId => {
          const m = maps[mapId];
          const marker = m.markers && m.markers[dayId];
          if (marker && m.map) {
            m.map.panTo(marker.getLatLng(), { animate: true });
            marker.openPopup();
          }
        });
      });
    });
  })();
</script>
