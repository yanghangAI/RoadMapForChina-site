---
interface Leg {
  from: string;
  to: string;
  mode: string;
  modeEmoji: string;
  duration: string;
  notes: string;
}

interface Props {
  legs: Leg[];
}

const { legs } = Astro.props;
---

<div class="overflow-x-auto my-4">
  <table class="w-full text-sm border-collapse">
    <thead>
      <tr class="bg-gray-100 dark:bg-gray-800">
        <th class="text-left font-semibold p-2 border-b-2 border-gray-300 dark:border-gray-600">Leg</th>
        <th class="text-left font-semibold p-2 border-b-2 border-gray-300 dark:border-gray-600">Mode</th>
        <th class="text-left font-semibold p-2 border-b-2 border-gray-300 dark:border-gray-600">Duration</th>
        <th class="text-left font-semibold p-2 border-b-2 border-gray-300 dark:border-gray-600">Notes</th>
      </tr>
    </thead>
    <tbody>
      {legs.map((leg) => (
        <tr class="border-b border-gray-200 dark:border-gray-700">
          <td class="p-2">{leg.from} → {leg.to}</td>
          <td class="p-2">{leg.modeEmoji} {leg.mode}</td>
          <td class="p-2">{leg.duration}</td>
          <td class="p-2 text-gray-600 dark:text-gray-400">{leg.notes}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
